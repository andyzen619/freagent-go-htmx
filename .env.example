# Copy to .env and fill in real values. Never commit .env itself.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Must match the app's Redirect URI in the Yahoo dashboard, character for character.
YAHOO_REDIRECT_URI=https://your-subdomain.ngrok-free.app/callback
# Optional: league key the players page reads, e.g. 470.l.123.
YAHOO_LEAGUE_KEY=
# Optional: "yahoo" (default) or "mock". Mock uses built-in sample players.
PLAYERS_SOURCE=
